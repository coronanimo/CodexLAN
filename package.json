  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/service.mjs start",
    "dev": "node server/index.mjs",
    "restart": "node server/service.mjs restart",
    "service:start": "node server/service.mjs start",
    "service:stop": "node server/service.mjs stop",
    "service:restart": "node server/service.mjs restart",
    "service:status": "node server/service.mjs status",
    "service:log": "node server/service.mjs log",
    "test": "node scripts/run-tests.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:watch": "vite build --watch --config web/vite.config.ts",
    "web:typecheck": "tsc --project web/tsconfig.json --noEmit",
    "web:test": "vitest run --config web/vite.config.ts",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "2.14.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "anser": "2.3.5",
    "jsdom": "31.0.0",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.1",
    "react-virtuoso": "4.18.20",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
